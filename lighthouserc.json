{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": [
        "/",
        "/events/hackathon/",
        "/schedule/",
        "/register/",
        "/blog/how-to-prepare-for-a-hackathon/",
        "/faq/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./reports/lighthouse-ci" }
  }
}
